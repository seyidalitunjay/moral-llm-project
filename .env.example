# Copy to .env, fill in the value, and keep .env out of version control.
#
# Nothing in this repository parses .env automatically. Load it in the shell
# before invoking a runner:
#
#     set -a; source .env; set +a
#
# Read by run_batch.py (legacy pipeline) and by
# research_audit_tools/run_control_pilot.py --execute (current pipeline).
OPENROUTER_API_KEY=
